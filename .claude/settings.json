{
  "permissions": {
    "ask": [
      "Bash(supabase db push:*)",
      "Bash(supabase migration up:*)",
      "Bash(gh pr merge:*)"
    ],
    "deny": [
      "Bash(vercel deploy:*)",
      "Bash(vercel --prod:*)",
      "Bash(git push origin main:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force:*)"
    ]
  },
  "autoMode": {
    "allow": [
      "$defaults"
    ]
  }
}
