# Copier en .env (jamais commite) et completer.

# Connexion au SQL Server du NAS (miroir Sage).
NAS_SQL_HOST=192.168.103.238
NAS_SQL_PORT=1433
NAS_SQL_DATABASE=SAGE_SERITEX
NAS_SQL_USER=nas_ecriture
